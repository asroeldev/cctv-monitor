# Copy to .env. Keep credentials private and do not commit this file.
APP_USERNAME=
APP_PASSWORD=

CAMERA_1_URL=
CAMERA_2_URL=
CAMERA_3_URL=
CAMERA_4_URL=
CAMERA_5_URL=
CAMERA_6_URL=

# Path to your own trained Ultralytics YOLO weights.
MODEL_PATH=
# Optional pretrained person-only model, used only when MODEL_PATH is empty.
PERSON_MODEL_PATH=
# 1 = infer on Camera 1 only; 0 = all configured cameras.
AI_CAMERA_ID=1
CONFIDENCE=0.5
DETECTION_INTERVAL=0.2
EVENT_COOLDOWN=30

# Cloud vision is opt-in. Keep the API key on the server, never in browser code.
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum seconds between requests; all people in the sampled frame are included.
GEMINI_INTERVAL=10
